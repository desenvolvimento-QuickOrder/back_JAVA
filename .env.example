# Copie para .env para sobrescrever os padrões do docker-compose (só desenvolvimento local).
POSTGRES_DB=quickorder
POSTGRES_USER=quickorder
POSTGRES_PASSWORD=quickorder
POSTGRES_PORT=5432
REDIS_PORT=6379
CORE_PORT=8080
JWT_PRIVATE_KEY_LOCATION=file:/run/keys/jwt-private.pem
JWT_KEY_ID=dev-local
JWT_PREVIOUS_PUBLIC_KEY_LOCATION=
JWT_PREVIOUS_KEY_ID=
QUICKORDER_SENHA_PEPPER=troque-este-pepper-no-ambiente-local
QUICKORDER_BOOTSTRAP_SLUG=restaurante-dev
QUICKORDER_BOOTSTRAP_ADMIN_LOGIN=
QUICKORDER_BOOTSTRAP_ADMIN_SENHA=
QUICKORDER_CORS_ORIGINS=http://localhost:3000

# Variáveis lidas pelo core (application.yml) ao rodar fora do Docker.
